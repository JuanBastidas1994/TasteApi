APP_ENV=development

# En Forge/DO usar 127.0.0.1 (no localhost) si MySQL no usa socket
DB_HOST=127.0.0.1
DB_DATABASE=digitalm_mi_ecommerce
DB_USERNAME=forge
DB_PASSWORD=

API_VERSION=v2
URL_RESOURCE=https://dashboard.mie-commerce.com/assets/resource/api/
URL_SISTEMA=https://dashboard.mie-commerce.com/
URL_UPLOAD=/home/forge/dashboard.mie-commerce.com/
URL_API=https://api.mie-commerce.com/taste-front/v2/
LOGIN_EMAIL_NUM_DIGITS=4

# Correos por API (Resend). DigitalOcean bloquea SMTP, por eso ya no se usa PHPMailer/SMTP.
# MAIL_DRIVER: resend = envia de verdad | log = no envia, guarda el correo en logs/<alias>/emails.log (local)
MAIL_DRIVER=resend
RESEND_API_KEY=
# MAIL_FROM debe ser de un dominio verificado en Resend; MAIL_REPLY_TO es a donde llegan las respuestas (tu bandeja GSuite)
MAIL_FROM=pedidos@mie-commerce.com
MAIL_REPLY_TO=info@mie-commerce.com
# Solo local/pruebas: redirige todos los correos a esta dirección (déjalo vacío en producción)
MAIL_REDIRECT_TO=
